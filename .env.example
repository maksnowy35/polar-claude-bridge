# Copy to .env and fill in. Never commit .env.
# Polar AccessLink app (admin.polaraccesslink.com) and the token from test_files/auth_script.py
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_USER_ID=

# Postgres (Neon). Empty = local SQLite in database/private/health.db
DATABASE_URL=
# only for tests, the schema is dropped on every run
TEST_DATABASE_URL=

# Google Drive: folder for context files and the raw archive (empty = created on first push)
GDRIVE_FOLDER_ID=
# OAuth client + refresh token with the drive.file scope, see README "Google Drive"
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
