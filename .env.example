# Copy to .env and fill in. Never commit .env.
# Polar AccessLink app (admin.polaraccesslink.com) and the token from test_files/auth_script.py
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_USER_ID=

# Postgres (Neon). Empty = local SQLite in database/private/health.db
DATABASE_URL=
# only for tests, the schema is dropped on every run
TEST_DATABASE_URL=

# Google Drive folder that receives the generated context files
GDRIVE_FOLDER_ID=
